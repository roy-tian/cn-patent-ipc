{
  "name": "cn-patent-ipc",
  "version": "0.1.2",
  "description": "Chinese-edition IPC patent classification — 79,972 entries (section/class/subclass/group) with titles and effective editions, plus the CNIPA strategic-emerging-industry (SEI) mapping. Zero runtime dependencies. 中文版专利国际专利分类(IPC)数据:约 8 万条分类号(含名称与生效版次),附战略性新兴产业(SEI)参照映射。",
  "keywords": [
    "patent",
    "ipc",
    "classification",
    "cnipa",
    "wipo",
    "sei",
    "strategic-emerging-industry",
    "专利",
    "国际专利分类",
    "战略性新兴产业"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./sei": {
      "types": "./dist/sei.d.ts",
      "import": "./dist/sei.js",
      "require": "./dist/sei.cjs"
    },
    "./data/*": "./data/*",
    "./sql/*": "./sql/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "data",
    "sql",
    "README.md",
    "README_zh.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "import:seed": "node scripts/import-seed.ts",
    "generate:sql": "node scripts/generate-sql.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.8.0"
  }
}
